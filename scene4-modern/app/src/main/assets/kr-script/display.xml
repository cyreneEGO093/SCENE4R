<?xml version="1.0" encoding="UTF-8" ?>
<items>
    <resource dir="file:///android_asset/kr-script/common" />
    <resource dir="file:///android_asset/kr-script/general" />
    <resource dir="file:///android_asset/kr-script/aosp" />

    <group title="屏幕与窗口">
        <page
            id="native_dpi"
            allow-shortcut="false"
            title="DPI、分辨率修改"
            desc="自定义手机 DPI 或分辨率（不当设置可能导致显示异常）" />
        <switch visible="run common/android_n.sh" shell="hidden">
            <title>强制分屏</title>
            <desc>适用于 Android 7.0+，允许未声明支持分屏的应用以分屏或调整大小模式运行</desc>
            <get>run general/force_resize_get.sh</get>
            <set>run general/force_resize_set.sh</set>
        </switch>
        <switch visible="run common/android_n.sh">
            <title>自由窗口</title>
            <desc>开启原生系统自由窗口模式，在多任务界面显示窗口化按钮</desc>
            <get>run aosp/free_form/get.sh</get>
            <set>run aosp/free_form/set.sh</set>
        </switch>
        <action shell="hidden">
            <title>过渡动画时长</title>
            <desc>分别调整弹窗、界面切换与动画程序缩放比例</desc>
            <params>
                <param name="w" title="弹窗动画时长"
                    options-sh="run general/animation/options.sh" value="1"
                    value-sh="settings get global window_animation_scale" />
                <param name="transition" title="界面切换动画时长"
                    options-sh="run general/animation/options.sh" value="1"
                    value-sh="settings get global transition_animation_scale" />
                <param name="animator" title="动画程序时长"
                    options-sh="run general/animation/options.sh" value="1"
                    value-sh="settings get global animator_duration_scale" />
            </params>
            <set>run general/animation/set.sh</set>
        </action>
        <picker>
            <title>旋转屏幕</title>
            <desc>设定系统方向旋转策略</desc>
            <options>
                <option value="0">正常</option>
                <option value="1">横屏</option>
                <option value="2">反转竖屏</option>
                <option value="3">反转横屏</option>
            </options>
            <get>settings get system user_rotation</get>
            <set>run aosp/rotation.sh</set>
        </picker>
        <page
            id="native_fullscreen"
            allow-shortcut="false"
            visible="if [[ $(getprop ro.build.version.sdk) -le 29 ]]; then echo 1; fi"
            title="沉浸式体验"
            desc="自动隐藏状态栏与导航栏（仅适用于 Android 10 及以下）" />
    </group>

    <group title="状态栏与外观">
        <switch>
            <title>悬浮通知</title>
            <desc>收到通知时在屏幕顶部显示悬浮横幅</desc>
            <get>settings get global heads_up_notifications_enabled</get>
            <set>settings put global heads_up_notifications_enabled $state</set>
        </switch>
        <picker multiple="multiple" separator="," visible="run common/android_n.sh">
            <title>隐藏状态栏图标</title>
            <desc>勾选需要在状态栏中屏蔽显示的系统图标</desc>
            <options>
                <option value="mobile">手机信号</option>
                <option value="volte">VoLTE</option>
                <option value="airplane">飞行模式</option>
                <option value="location">定位图标</option>
                <option value="wifi">WIFI</option>
                <option value="nfc">NFC</option>
                <option value="vpn">VPN</option>
                <option value="bluetooth">蓝牙</option>
                <option value="volume">音量/静音</option>
                <option value="zen">勿扰模式</option>
                <option value="alarm_clock">闹钟</option>
                <option value="headset">耳机</option>
                <option value="ime">输入法</option>
                <option value="battery">电池图标</option>
                <option value="rotate">屏幕旋转</option>
                <option value="cast">屏幕捕获(录屏)</option>
                <option value="su">ROOT权限</option>
            </options>
            <get>settings get secure icon_blacklist</get>
            <set>settings put secure icon_blacklist "$state"</set>
        </picker>
        <action>
            <title>系统夜间模式</title>
            <desc>切换系统底层的夜间模式开关状态</desc>
            <params>
                <param name="state" title="夜间模式" value-sh="settings get secure ui_night_mode">
                    <option value="0">自动</option>
                    <option value="1">关闭</option>
                    <option value="2">开启</option>
                </param>
                <param name="hotreboot" title="附加操作">
                    <option value="0">不需要（AOSP）</option>
                    <option value="1">切换后重启（MIUI 等）</option>
                </param>
            </params>
            <set>run aosp/night_mode.sh</set>
        </action>
        <action id="addin_restart_systemui" shell="hidden">
            <title>重启 SystemUI</title>
            <desc>结束 SystemUI 进程使其重新加载界面状态</desc>
            <set>
                am kill com.android.systemui 2> /dev/null
                killall -9 com.android.systemui 2> /dev/null
            </set>
        </action>
    </group>

    <group title="视觉辅助">
        <switch shell="hidden">
            <title>高对比度文字</title>
            <desc>锐化文字轮廓并增强对比度，方便阅读</desc>
            <get>settings get secure high_text_contrast_enabled</get>
            <set>settings put secure high_text_contrast_enabled $state</set>
        </switch>
        <switch auto-off="true" auto-finish="true" shell="hidden" id="display_daltonizer">
            <title>色彩校正</title>
            <get>settings get secure accessibility_display_daltonizer_enabled</get>
            <set>
                mode=`settings get secure accessibility_display_daltonizer`
                if [[ "$mode" == "null" ]] || [[ "$mode" == "" ]]; then
                    settings put secure accessibility_display_daltonizer 0
                fi
                settings put secure accessibility_display_daltonizer_enabled $state
            </set>
        </switch>
        <picker auto-off="true" shell="hidden">
            <title>色彩校正模式</title>
            <options>
                <option value="0">黑白模式</option>
                <option value="1">红色视弱（红绿不分）</option>
                <option value="2">绿色视弱（红绿不分）</option>
                <option value="3">蓝色视弱（蓝黄不分）</option>
            </options>
            <get>settings get secure accessibility_display_daltonizer</get>
            <set>settings put secure accessibility_display_daltonizer $state</set>
        </picker>
    </group>
</items>
