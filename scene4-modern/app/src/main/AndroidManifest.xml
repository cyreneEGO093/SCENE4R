<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.RECEIVE_USER_PRESENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.CHANGE_CONFIGURATION"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <application
        android:name="com.omarea.Scene"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:persistent="false"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:ignore="GoogleAppIndexingWarning,UnusedAttribute">

        <provider
            android:name=".SceneFreezeProvider"
            android:authorities="com.omarea.vtools.SceneFreezeProvider"
            android:enabled="true"
            android:exported="true" />

        <activity
            android:name=".activities.ActivityPowerModeTile"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityAppXposedDetails"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.omarea.scene_mode.TriggerExecutorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Execute user-configured root automation triggers" />
        </service>

        <service
            android:name="com.omarea.scene_mode.SceneTaskIntentService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Execute user-configured scheduled root tasks" />
            <intent-filter>
                <action android:name="com.omarea.scene_mode.TimingTaskReceiver" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.omarea.scene_mode.ReceiverSceneMode"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.omarea.scene_mode.ReceiverSceneMode" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.omarea.vtools.ReceiverCompileState"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.omarea.vtools.ReceiverCompileState" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="SCENE4R 内置 Xposed 高级设定模块（独立 DPI、隐藏最近任务、弹性滚动、WebView 调试与偏见自动解冻）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="android.max_aspect"
            android:value="2.8" />

        <activity
            android:name=".activities.ActivityStartSplash"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityMain"
            android:autoRemoveFromRecents="false"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|density|screenLayout|fontScale|smallestScreenSize"
            android:excludeFromRecents="false"
            android:exported="true"
            android:label="@string/app_name_short"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.LAUNCHER" />
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".activities.ActivityOtherSettings"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="SCENE4R 杂项设置"
            android:launchMode="singleTop" />

        <activity
            android:name=".activities.ActivityHiddenApps"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="[隐藏/卸载]的应用"
            android:launchMode="singleTop" />

        <activity
            android:name=".activities.ActivityAddinOnline"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="false"
            android:label="@string/title_activity_online"
            android:launchMode="standard" />

        <activity
            android:name=".activities.ActivityAppDetails"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="应用场景">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityFileSelector"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/title_activity_file_selector"
            android:launchMode="standard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityTimingTask"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="@string/title_activity_timing_task"
            android:launchMode="standard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityTrigger"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="@string/title_activity_trigger"
            android:launchMode="standard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityQuickStart"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/title_activity_shortcut"
            android:theme="@style/AppThemeTransparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityFreezeApps"
            android:configChanges="keyboardHidden|orientation|uiMode|screenSize|smallestScreenSize"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/freeze_logo"
            android:label="@string/title_activity_freeze"
            android:launchMode="singleTask"
            android:multiprocess="false"
            android:noHistory="true"
            android:roundIcon="@drawable/freeze_logo"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".activities.ActivityFreezeApps2"
            android:enabled="true"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="false"
            android:targetActivity=".activities.ActivityFreezeApps" />

        <activity
            android:name=".activities.ActionPage"
            android:configChanges="keyboardHidden|orientation|uiMode|layoutDirection|screenLayout|colorMode|fontScale|smallestScreenSize|density|keyboard|screenSize|touchscreen"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActionPageOnline"
            android:configChanges="keyboardHidden|orientation|uiMode|layoutDirection|screenLayout|colorMode|fontScale|smallestScreenSize|density|keyboard|screenSize|touchscreen"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.ActivityAddin" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityApplistions" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivitySwap" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityImg" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityBattery" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityCharge" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityProcess" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" android:taskAffinity="activities.ActivityProcess" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".activities.ActivityMagisk" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.ActivityCpuControl" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivitySchedulerTuning" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.ActivityCpuModes" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityBatteryStats" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityAppConfig2" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityAppXposedConfig" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivitySystemScene" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityAutoClick" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" />
        <activity android:name=".activities.ActivityMiuiThermal" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.ActivityCustomCommand" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.ActivityFpsChart" android:configChanges="orientation|screenSize|smallestScreenSize" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".ReceiverBoot"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.omarea.scene_mode.ReceiverShortcut"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.omarea.vtools.SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AccessibilityScenceMode"
            android:configChanges="orientation|screenLayout|fontScale|smallestScreenSize|density|screenSize"
            android:exported="true"
            android:label="SCENE4R - 场景模式"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_accessibility" />
        </service>

        <service
            android:name="com.omarea.scene_mode.NotificationListenerService"
            android:exported="true"
            android:label="通知过滤服务"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".services.BootService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Apply user-configured root boot settings" />
        </service>

        <service
            android:name=".services.CompileService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Run dex2oat compilation tasks via root" />
        </service>

        <service
            android:name="com.omarea.scene_mode.SceneTileService"
            android:exported="true"
            android:icon="@drawable/p4"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
